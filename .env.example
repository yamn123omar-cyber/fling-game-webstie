# ── Basics ──────────────────────────────────────────────────────────────
PORT=3000
# Where the database file lives. Point this at a persistent disk in production.
DATA_DIR=./data
# Comma-separated usernames that become admins when they sign up / first log in.
# Recommended in production. If empty, the very first account on a fresh database
# is the admin (or only okok_0020 while old accounts are being imported).
ADMIN_USERNAMES=

# ── Discord (all optional) ──────────────────────────────────────────────
DISCORD_BOT_TOKEN=
# Channel that receives a compressed database backup every few minutes.
# Strongly recommended on hosts that wipe the disk on redeploy (Render free tier etc.).
# Falls back to DISCORD_CHANNEL_ID (the old data channel) if not set.
DISCORD_BACKUP_CHANNEL_ID=
BACKUP_INTERVAL_MINUTES=5
# Channel for announcements (new tournaments, results, champions).
DISCORD_RESULTS_CHANNEL_ID=
# Server that holds the old "profile-<name>" channels. Lets people from the
# previous site log in with their old password; their account is imported.
DISCORD_GUILD_ID=

# ── Limits ──────────────────────────────────────────────────────────────
REGISTER_LIMIT_PER_HOUR=20
