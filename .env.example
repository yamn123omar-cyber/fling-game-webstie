# ── Basics ──────────────────────────────────────────────────────────────
PORT=3000
# Where the database file lives. Point this at a persistent disk in production.
DATA_DIR=./data
# The owner account (gets the Owner panel). Defaults to okok_0020.
OWNER_USERNAME=okok_0020
# Optional: usernames that start as admin (the owner can also do this on the site).
ADMIN_USERNAMES=

# ── Discord (optional, recommended) ─────────────────────────────────────
# The bot needs Administrator (or Manage Channels + Manage Roles, View Channels,
# Send Messages, Attach Files, Read Message History). Rebuild the server layout
# from Owner panel → Discord server.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
BACKUP_INTERVAL_MINUTES=5

# ── Limits ──────────────────────────────────────────────────────────────
REGISTER_LIMIT_PER_HOUR=20
